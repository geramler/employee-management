{
  "info": {
    "name": "Employee Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Get employee",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/1"
      }
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[{\n  \"firstName\": \"Ana\",\n  \"secondName\": \"Maria\",\n  \"paternalSurname\": \"Garcia\",\n  \"maternalSurname\": \"Lopez\",\n  \"age\": 30,\n  \"sex\": \"FEMALE\",\n  \"birthDate\": \"19-11-1995\",\n  \"position\": \"Developer\",\n  \"active\": true\n}]"
        },
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"position\": \"Lead Developer\",\n  \"active\": false\n}"
        },
        "url": "{{baseUrl}}/employees/1"
      }
    },
    {
      "name": "Search employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/search?name=Ana"
      }
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/employees/1"
      }
    }
  ]
}
